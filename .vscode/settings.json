{
    "editor.fontSize": 18,
    "terminal.integrated.fontSize": 18,
    "workbench.tree.indent": 18,
    "clangd.path": "C:\\Program Files\\LLVM\\bin\\clangd.exe",
    "clangd.arguments": [
        "--header-insertion=never",
        "--compile-commands-dir=${workspaceFolder}",
        "--experimental-modules-support"
